#!/usr/bin/env bash

set -euo pipefail

pause_on_exit=false
if [[ "${1:-}" == --from-ui ]]; then
  pause_on_exit=true
fi

finish() {
  local exit_code=$?
  if [[ "$pause_on_exit" == true && -t 0 ]]; then
    printf '\nPress Enter to close…'
    read -r _ || true
  fi
  exit "$exit_code"
}
trap finish EXIT

printf '\nMihoro Installer\n'
printf '================\n\n'
curl -fsSL https://raw.githubusercontent.com/spencerwooo/mihoro/main/install.sh | sh
